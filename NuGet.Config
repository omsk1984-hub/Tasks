<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    В окружении сборки TLS-соединение к api.nuget.org не устанавливается
    (прокси с TLS-инспекцией -> "Authentication failed" в цепочке сертификатов),
    поэтому `dotnet add package` падает на NU1301.

    Обходной путь: нужные .nupkg скачаны curl-ом (curl работает) в папку
    local-packages/ и подключены как локальный источник. Папка находится в
    .gitignore, пакеты пере-скачиваются скриптом tools/restore-offline.ps1.
  -->
  <packageSources>
    <clear />
    <add key="local-offline" value="local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
