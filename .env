# =============================================================================
# Tasks — фактические переменные окружения (локальная разработка).
# Файл в .gitignore; секретов здесь нет (dev-значения).
#
# Формат имён: секции конфигурации .NET разделяются двойным подчёркиванием
# (например, ConnectionStrings:Postgres -> ConnectionStrings__Postgres).
# =============================================================================

# --- PostgreSQL (контейнер Tasks_postgres, см. db/docker-compose.yml) ---
# Внешний порт 5442 выбран, чтобы не конфликтовать с другими локальными Postgres
# (на 5432 уже слушает artas_postgres).
DB__HOST=localhost
DB__PORT=5442
DB__DATABASE=tasks_db
DB__USER=tasks_user
DB__PASSWORD=tasks_password

# Строка подключения для .NET-приложения (имеет приоритет над appsettings.json).
ConnectionStrings__Postgres=Host=localhost;Port=5442;Database=tasks_db;Username=tasks_user;Password=tasks_password

# --- RabbitMQ (контейнер Tasks_rabbitmq) ---
RABBITMQ__HOST=localhost
# Внешний порт 5673 (внутри контейнера 5672), во избежание конфликтов.
RABBITMQ__PORT=5673
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__VIRTUALHOST=/
# Обменник и routing key из ТЗ:
RABBITMQ__EXCHANGE=task.events
RABBITMQ__ROUTINGKEY=task.completed
# Таймаут ожидания in-flight публикаций при graceful shutdown (секунды).
RABBITMQ__SHUTDOWNDRAINTIMEOUTSECONDS=4

# Порт management UI RabbitMQ (http://localhost:15673) — используется docker-compose.
RABBITMQ__MANAGEMENT_PORT=15673

# --- ASP.NET Core ---
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development

# --- Логи ---
# Единый каталог логов (если не задан — logs/ в корне репозитория).
LOGS_DIR=D:\work\Tasks\logs
