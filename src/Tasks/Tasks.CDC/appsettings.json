{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5442;Database=tasks_db;Username=tasks_user;Password=tasks_password"
  },
  "//Cdc": "Воркер читает WAL (logical replication, pgoutput) таблицы outbox_messages и публикует события в RabbitMQ.",
  "Cdc": {
    "SlotName": "tasks_outbox_slot",
    "PublicationName": "tasks_outbox_pub",
    "OutboxTable": "outbox_messages",
    "ReconnectDelaySeconds": 5
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5673,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "task.events",
    "ShutdownDrainTimeoutSeconds": 4
  },
  "//Logs": "Directory подставляется из .env (LOGS_DIR -> Logs__Directory). В коде есть fallback на <repoRoot>/logs.",
  "Logs": {
    "Directory": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
