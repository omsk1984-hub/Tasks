<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Прокси с TLS-инспекцией ломает HTTPS к api.nuget.org (NU1301 / "Authentication failed").
    Все необходимые .nupkg скачаны curl-ом в ../../local-packages и подключены
    как локальный источник. Для отсутствующих в локальной папке пакетов,
    которые уже лежат в global-packages кэше, restore берёт их оттуда.
  -->
  <packageSources>
    <clear />
    <add key="local-offline" value="../../local-packages" />
  </packageSources>
</configuration>
