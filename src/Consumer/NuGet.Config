<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Прокси с TLS-инспекцией ломает HTTPS к api.nuget.org (NU1301 / "Authentication failed").
    Все необходимые .nupkg лежат в ../../local-packages и в global-packages кэше.
    Источник nuget.org оставлен как fallback, но restore берёт пакеты локально.
  -->
  <packageSources>
    <clear />
    <add key="local-offline" value="../../local-packages" />
  </packageSources>
</configuration>
