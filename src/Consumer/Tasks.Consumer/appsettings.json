{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5442;Database=tasks_db;Username=tasks_user;Password=tasks_password"
  },
  "Db": {
    "MigrateOnStartup": true
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5673,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "task.events",
    "RoutingKey": "task.completed",
    "Queue": "tasks.task.completed",
    "PrefetchCount": 10
  },
  "//Logs": "Directory подставляется из .env (LOGS_DIR -> Logs__Directory). В коде есть fallback на <repoRoot>/logs.",
  "Logs": {
    "Directory": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
